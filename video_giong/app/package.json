{
  "name": "phat-thanh-noi-bo",
  "version": "1.0.0",
  "description": "Biên tập và xuất chương trình phát thanh nội bộ (giọng đọc AI miễn phí, MP3/MP4)",
  "scripts": {
    "start": "node server.mjs",
    "app": "electron .",
    "test": "node --test test/*.test.mjs",
    "dist": "electron-builder --win portable",
    "build:demo": "node scripts/build-demo.mjs"
  },
  "type": "commonjs",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "msedge-tts": "^2.1.1",
    "word-extractor": "^1.0.4"
  },
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "vn.phatthanh.noibo",
    "productName": "Phat thanh noi bo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "server.mjs",
      "lib/**",
      "public/**",
      "tts/**",
      "electron/**",
      "demo/**",
      "package.json",
      "!data/**",
      "!test/**",
      "!dist/**",
      "!scripts/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "tts/**"
    ],
    "win": {
      "target": "portable",
      "icon": "electron/icon-256.png"
    }
  }
}
