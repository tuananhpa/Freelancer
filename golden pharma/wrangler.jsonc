{
  "name": "golden-pharma",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "GOLDEN_DATA_KV",
      "id": "0a42cb6e602048a1bbc291ad81c5488f"
    }
  ],
  "observability": {
    "enabled": true
  }
}
