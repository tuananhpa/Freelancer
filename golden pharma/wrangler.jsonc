{
  "name": "golden-pharma",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
