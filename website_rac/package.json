{
  "name": "truong-hoc-xanh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:ui": "node tests/browser.cjs",
    "cf:login": "wrangler login",
    "cf:dev": "npm run build && wrangler dev --local --ip 127.0.0.1 --port 8787",
    "cf:check": "npm run build && wrangler deploy --dry-run",
    "cf:deploy": "npm run build && wrangler deploy",
    "tunnel:serve": "npm run build && vite preview",
    "tunnel:open": "cloudflared tunnel --url http://127.0.0.1:4173"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "vite": "^7.1.0",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
