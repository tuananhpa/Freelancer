# true  = chạy bằng dữ liệu giả lập (localStorage), không cần backend
# false = gọi API thật tại VITE_API_BASE_URL
VITE_USE_MOCK=true

# Gốc API của backend (khi VITE_USE_MOCK=false). Dùng /api nếu đi qua dev proxy.
VITE_API_BASE_URL=/api/v1

# Dev proxy: Vite chuyển tiếp /api -> backend (tùy chọn)
VITE_DEV_PROXY_TARGET=

# Tên miền công khai dùng để mã hóa vào QR
VITE_PUBLIC_SITE_URL=https://hytales.vn

# Zalo / hotline mặc định khi sản phẩm chưa cấu hình riêng
VITE_DEFAULT_ZALO=https://zalo.me/

# Tài khoản admin demo — CHỈ dùng ở chế độ mock (VITE_USE_MOCK=true)
VITE_MOCK_ADMIN_EMAIL=admin@hytales.vn
VITE_MOCK_ADMIN_PASSWORD=hytale-demo
