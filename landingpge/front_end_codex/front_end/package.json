{
  "name": "hytales-front-end",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "node scripts/verify-browser.cjs",
    "test:admin": "node scripts/verify-admin.cjs",
    "test:hero": "node scripts/verify-hero.cjs",
    "test:content": "node scripts/verify-content.cjs",
    "test:inquiry-chat": "node scripts/verify-inquiry-chat.cjs",
    "test:journey": "node scripts/verify-journey-readability.cjs",
    "test:appearance": "node scripts/verify-appearance.cjs",
    "test:carousel": "node scripts/verify-product-carousel.cjs",
    "test:video-aspect": "node scripts/verify-video-aspect.cjs",
    "test:players": "node scripts/verify-player-improvements.cjs",
    "test:video-sources": "node scripts/verify-source-videos.cjs",
    "format": "prettier --write src scripts docs index.html package.json tsconfig.json vite.config.ts README.md"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsqr": "^1.4.0",
    "playwright": "^1.64.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.3"
  }
}
