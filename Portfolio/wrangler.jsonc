{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freelance-portfolio",
  "account_id": "42a329bcd1bb4efa8f00aca84d43a537",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [{"binding": "DB", "database_name": "freelance-portfolio-db", "database_id": "968af4df-318b-433d-8b58-4d19fbbbdd01", "migrations_dir": "migrations"}],
  "triggers": {"crons": ["0 3 * * *"]}
}
