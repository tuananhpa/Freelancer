{
  "name": "coffee-saas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "typecheck": "vue-tsc --noEmit -p apps/web/tsconfig.json",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts",
